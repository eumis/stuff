{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small" },
  "display": {
    "key": {
        "width": 15
    },
    "bar": {
        "char": {
            "elapsed": "=",
            "total": "-"
        },
        "width": 13
    },
    "percent": {
        "type": 2
    }
  },
  "modules": [
    "os",
    "kernel",
    {
        "type": "wm",
        "key": "WM"
    },
    "terminal",
    "terminalfont",
    "shell",
    {
        "type": "disk",
        "key": "OS Age",
        "folders": "/",
        "format": "{create-time:10} [{days} days]"
    },
    "uptime",
    "cpuusage",
    "memory",
    {
        "type": "disk",
        "key": "Disk",
        "folders": "/"
    },
    {
        "type": "colors",
        "paddingLeft": 14,
        "symbol": "circle"
    }
  ]
}
